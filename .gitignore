# ── Dependencies ──────────────────────────────────────────────
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Next.js ───────────────────────────────────────────────────
.next/
out/
build/
dist/

# ── Production deploys ────────────────────────────────────────
.vercel

# ── Logs ──────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*
lerna-debug.log*
logs/
*.log

# ── Environment & secrets ─────────────────────────────────────
# Keep templates (*.example) committed; never commit real secrets.
.env
.env.*
!.env.example
!.env.*.example
!.env.local.example
*.pem

# Supabase service-role / CLI artefacts
supabase/.temp/
supabase/.branches/

# ── Files generated at runtime (geometry/attachment downloads) ─
downloads/

# ── Public media assets (videos, sounds, brand files) ─────────
# Everything in public/ stays local except the nav logo the app needs.
v3-mui/public/*
!v3-mui/public/mic2.svg

# ── TypeScript ────────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ── Testing / coverage ────────────────────────────────────────
coverage/
.nyc_output/

# ── Editors / IDEs ────────────────────────────────────────────
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~
.history/

# ── OS junk ───────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
$RECYCLE.BIN/

# ── Claude Code local settings ────────────────────────────────
.claude/settings.local.json
